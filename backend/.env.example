# Variables lues par backend/config/env.js (seule source pour le backend)
# PORT=3001
# NODE_ENV=production
DATABASE_URL="postgresql://user:password@localhost:5432/zerok_billing"
SESSION_SECRET="change-me-in-production-min-32-chars"
# FRONTEND_ORIGIN=http://localhost:5173 (ou liste séparée par des virgules)
# COOKIE_SECURE=true (en prod HTTPS)
# Email de vérification (voir docs/VERIFICATION_EMAIL_GMAIL.md)
# GMAIL_USER=ton-adresse@gmail.com
# GMAIL_APP_PASSWORD=mot-de-passe-application-16-caracteres
# Stripe webhook (vérification signature)
# STRIPE_WEBHOOK_SECRET=whsec_...
# Chiffrement clé Stripe en base (64 caractères hex = 32 bytes). Si absent, stockage en clair.
# CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
